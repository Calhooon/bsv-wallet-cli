      "access-control-expose-headers": "retry-after",
      "content-type": "application/json",
      "vary": "origin, access-control-request-method, access-control-request-headers"
    },
    "json": {
      "totalOutputs": 2,
      "outputs": [
        {
          "satoshis": 30000,
          "spendable": true,
          "outpoint": "7777777777777777777777777777777777777777777777777777777777777777.0"
        },
        {
          "satoshis": 20000,
          "spendable": true,
          "outpoint": "8888888888888888888888888888888888888888888888888888888888888888.0"
        }
      ]
    }
  }
}
