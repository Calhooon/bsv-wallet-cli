{
  "consumer": "e2e-harness",
  "call": "listOutputs.balance",
  "source": "tests/e2e/lib/wallet-client.js balance",
  "world": "pending",
  "request": {
    "method": "POST",
    "path": "/listOutputs",
    "headers": {
      "origin": "http://e2e-test"
    },
    "json": {
      "basket": "default",
      "limit": 10000,
      "includeEnvelope": false
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "access-control-allow-credentials": "true",
