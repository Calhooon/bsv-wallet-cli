{
  "world": "named-change",
  "request": {
    "method": "POST",
    "path": "/createAction",
    "headers": {
      "origin": "http://wire.test"
    },
    "json": {
      "description": "wire named change",
      "inputs": [
        {
          "inputDescription": "our change",
          "outpoint": "2222222222222222222222222222222222222222222222222222222222222222.0",
          "unlockingScriptLength": 107
        }
      ],
      "outputs": [
        {
          "lockingScript": "76a914dbc0a7c84983c5bf199b7b2d41b3acf0408ee5aa88ac",
          "outputDescription": "an output",
          "satoshis": 1000
        }
      ]
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "access-control-allow-credentials": "true",
      "access-control-allow-origin": "http://wire.test",
      "access-control-expose-headers": "retry-after",
      "content-type": "application/json",
      "vary": "origin, access-control-request-method, access-control-request-headers"
    },
    "json": {
      "code": "VALIDATION_ERROR",
      "message": "wallet error: Validation error: The inputs[0] parameter must be an unmanaged input. Change outputs are managed by your wallet."
