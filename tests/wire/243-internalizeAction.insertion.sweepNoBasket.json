{
  "world": "internalize",
  "request": {
    "method": "POST",
    "path": "/internalizeAction",
    "headers": {
      "origin": "http://wire.test"
    },
    "json": {
      "description": "wire internalize rules",
      "outputs": [
        {
          "insertionRemittance": {
            "basket": "swept"
          },
          "outputIndex": 0,
          "protocol": "basket insertion"
        }
      ],
      "tx": "<bound>"
    },
    "bind": {
      "/tx": {
        "file": "242-createAction.internalize.noBasket.json",
        "pointer": "/tx"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "access-control-allow-credentials": "true",
      "access-control-allow-origin": "http://wire.test",
      "access-control-expose-headers": "retry-after",
      "content-type": "application/json",
      "vary": "origin, access-control-request-method, access-control-request-headers"
    },
    "json": {
      "accepted": true
    }
  }
}
