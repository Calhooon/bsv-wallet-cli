{
  "about": "Arcade's status words and the verdict each client must give. One recorded body per Arcade word on each surface a client reads (the POST /tx answer, the GET /tx/{txid} document, the SSE frame or webhook body), the intake refusals (HTTP 400 with the ARC code in the body's status field), the two reorg-correction payloads, and the latch sequence of the scenario of record. The same file is carried byte-identical by bsv-wallet-toolbox-rs (tests/vectors/) and bsv-overlay-cloudflare (crates/overlay-discovery/vectors/). Placeholders: {TXID} the subject txid, {BUMP} a BRC-74 path for {TXID} at the case's blockHeight, {NOW} a current RFC 3339 stamp, {COMPETITOR} a second txid.",
  "pins": {
    "arcade": "bsv-blockchain/arcade@1ae1208e64b77b64818044d606638939d9f1834a",
    "arc": "bitcoin-sv/arc@e7efc5b",
    "ts_stack": "bsv-blockchain/ts-stack@edf6e03dad39bd7bc4fc6e73e64de3a2b6f805c9"
  },
  "rule": {
    "failure": "REJECTED; DOUBLE_SPEND_ATTEMPTED as a conflict; any word containing ORPHAN (any letter case)",
    "accepted": "every other word Arcade defines, carried as the hint it is (pending, seen, mined)",
    "invalid": "a word Arcade does not define, an empty word, no word: an invalid response, never a success and never a verdict on the transaction",
    "reorg": "extraInfo reorg_unmined or reorg_reanchor: a re-ask, never a status change by itself (the tracker's rule, bsv-stack-lean docs/RULINGS-2026-10.md:32)",
    "intake": "HTTP 400 carries the ARC code in the body's status; 476 is non-final, nothing persisted, retryable; 460-475 are verdicts on the bytes",
    "conflict_code": "a REJECTED row whose status is 466 is a conflict (the input is owned by a competing or confirmed transaction); a REJECTED row whose status is 476 is retryable"
  },
  "words": [
    { "word": "UNKNOWN", "class": "pending", "meaning": "the status is unknown; written by no production path at the pin", "cite": "models/transaction.go:90-91; git grep StatusUnknown finds no writer outside models/" },
    { "word": "RECEIVED", "class": "pending", "meaning": "Arcade received it; every fresh POST /tx answers 202 RECEIVED", "cite": "models/transaction.go:92-93; services/api_server/handlers.go:1014-1018" },
    { "word": "SENT_TO_NETWORK", "class": "pending", "meaning": "sent to the network; REJECTED may still follow", "cite": "models/transaction.go:94-95, 227-237" },
    { "word": "ACCEPTED_BY_NETWORK", "class": "pending", "meaning": "accepted by a peer", "cite": "models/transaction.go:96-97" },
    { "word": "SEEN_ON_NETWORK", "class": "seen", "meaning": "seen on the network; after a reorg revert it carries extraInfo reorg_unmined", "cite": "models/transaction.go:98-99, 329-331" },
    { "word": "SEEN_MULTIPLE_NODES", "class": "seen", "meaning": "seen by multiple independent miners", "cite": "models/transaction.go:100-101" },
    { "word": "DOUBLE_SPEND_ATTEMPTED", "class": "conflict", "meaning": "a double spend was attempted; terminal; declared, no writer found at the pin (the matrix's double_spend_mempool cell)", "cite": "models/transaction.go:102-103, 133-138" },
    { "word": "REJECTED", "class": "rejected", "meaning": "rejected; terminal; the ARC code rides in status (466 conflict, 467 generic, 471 frozen, 476 non-final and retryable)", "cite": "models/transaction.go:104-105; services/propagation/propagator.go:1891-1951" },
    { "word": "PENDING_RETRY", "class": "pending", "meaning": "no network verdict after the fast path's attempts; parked for durable rebroadcast; retryable", "cite": "models/transaction.go:106-107; services/propagation/propagator.go:2362-2395" },
    { "word": "STUMP_PROCESSING", "class": "seen", "meaning": "the transaction has a STUMP and Arcade is building the BUMP: it is in a block, the proof is not built; written by no production path at the pin", "cite": "models/transaction.go:108-109, 219-226" },
    { "word": "MINED", "class": "mined", "meaning": "mined; the body carries blockHash, blockHeight and merklePath; after a reorg re-anchor it carries extraInfo reorg_reanchor and the new path", "cite": "models/transaction.go:110-111, 326-328; services/webhook/service.go:317-327" },
    { "word": "IMMUTABLE", "class": "mined", "meaning": "immutable: mined and past the depth; the webhook and SSE bodies carry the merkle path as for MINED", "cite": "models/transaction.go:112-113; services/webhook/service.go:317-327, 391; services/sse/manager.go:1127-1149" }
  ],
  "outcomes": {
    "toolbox_arcade_submit": "Arcade::post_beef of a one-transaction BEEF: success | rejected (is_definitive_rejection, not double_spend) | double_spend | orphan (orphan_mempool) | service_error (transient, retried)",
    "toolbox_arc_submit": "Arc::post_raw_tx (the ARC client, /v1/tx) given the same 2xx body: success | rejected | double_spend | orphan | service_error",
    "toolbox_status": "Arcade::get_status_for_txids detail status: known | mined | unknown; toolbox_proof: whether Arcade::get_merkle_path serves the path",
    "toolbox_push": "ArcadeEventsTask::apply_event on a transaction in sending/sending, with a chain tracker that knows {BUMP}'s root: none (no word applied; a REJECTED or DOUBLE_SPEND_ATTEMPTED is recorded as the hint it is and a competitor it names is queued for a proof ask, bsv-stack-lean #66, the toolbox from 0.7.4) | seen (unmined/unproven) | seen+reask (seen and the proof fetch triggered) | reask (nothing applied, the proof fetch triggered) | proven (the path ingested through the funnel, req completed)",
    "engine_gate": "broadcaster::classify_arcade_status against SEEN_ON_NETWORK: reached | fatal | orphan | pending (pending is also the engine's treatment of an invalid word: it never admits and never refuses; the ladder ends at the second broadcaster)",
    "engine_callback": "admit_fast::callback_action: latch_seen | evidence_check | ignore",
    "engine_submit": "broadcaster::classify_submit_response: processing | sync_rejected | view_rejected | transport",
    "engine_proof": "proof_fetcher::parse_arcade_proof_look at {NOW}: mined | known_unmined | unknown",
    "engine_marker": "pot::reorg::arcade_reorg_marker: reanchor | unmined | none"
  },
  "cases": [
    { "name": "submit_202_unknown", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "UNKNOWN" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_received", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "RECEIVED" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_sent_to_network", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "SENT_TO_NETWORK" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_accepted_by_network", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "ACCEPTED_BY_NETWORK" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_seen_on_network", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "SEEN_ON_NETWORK" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "reached", "engine_callback": "latch_seen" } },
    { "name": "submit_202_seen_multiple_nodes", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "SEEN_MULTIPLE_NODES" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "reached", "engine_callback": "latch_seen" } },
    { "name": "submit_202_double_spend_attempted", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "DOUBLE_SPEND_ATTEMPTED" }, "expect": { "toolbox_arcade_submit": "double_spend", "toolbox_arc_submit": "double_spend", "engine_gate": "fatal", "engine_callback": "evidence_check" } },
    { "name": "submit_202_rejected", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "REJECTED" }, "expect": { "toolbox_arcade_submit": "rejected", "toolbox_arc_submit": "rejected", "engine_gate": "fatal", "engine_callback": "evidence_check" } },
    { "name": "submit_202_pending_retry", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "PENDING_RETRY" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_stump_processing", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "STUMP_PROCESSING" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "reached", "engine_callback": "latch_seen" } },
    { "name": "submit_202_mined", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "MINED" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "reached", "engine_callback": "latch_seen" } },
    { "name": "submit_202_immutable", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "IMMUTABLE" }, "expect": { "toolbox_arcade_submit": "success", "toolbox_arc_submit": "success", "engine_gate": "reached", "engine_callback": "latch_seen" } },
    { "name": "submit_202_rejected_lower_case", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "rejected" }, "expect": { "toolbox_arcade_submit": "rejected", "toolbox_arc_submit": "rejected", "engine_gate": "fatal", "engine_callback": "evidence_check" } },
    { "name": "submit_202_orphan_word", "surface": "submit", "http": 202, "note": "not an Arcade word (Arcade has no ORPHAN status, models/transaction.go:89-114); ARC's (metamorph_api.proto:22); carried for the ORPHAN rule", "body": { "txid": "{TXID}", "status": 202, "txStatus": "SEEN_IN_ORPHAN_MEMPOOL" }, "expect": { "toolbox_arcade_submit": "orphan", "toolbox_arc_submit": "orphan", "engine_gate": "orphan", "engine_callback": "evidence_check" } },
    { "name": "submit_202_mined_in_stale_block", "surface": "submit", "http": 202, "note": "ARC's word (metamorph_api.proto:26), not Arcade's: to an Arcade client an undefined word; to the ARC client a transient failure (ts-stack wallet-toolbox ARC.ts:373-376)", "body": { "txid": "{TXID}", "status": 202, "txStatus": "MINED_IN_STALE_BLOCK" }, "expect": { "toolbox_arcade_submit": "service_error", "toolbox_arc_submit": "service_error", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_undefined_word", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "NOT_A_STATUS" }, "expect": { "toolbox_arcade_submit": "service_error", "toolbox_arc_submit": "service_error", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_empty_word", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202, "txStatus": "" }, "expect": { "toolbox_arcade_submit": "service_error", "toolbox_arc_submit": "service_error", "engine_gate": "pending", "engine_callback": "ignore" } },
    { "name": "submit_202_no_word", "surface": "submit", "http": 202, "body": { "txid": "{TXID}", "status": 202 }, "expect": { "toolbox_arcade_submit": "service_error", "toolbox_arc_submit": "service_error" } },

    { "name": "submit_400_476_non_final", "surface": "submit", "http": 400, "cite": "services/api_server/handlers.go:899-925, 1036-1050; errors/errors.go:54-60, 196-198", "body": { "error": "transaction failed validation", "txid": "{TXID}", "reason": "transaction is not final: nLockTime 900000 not reached (tip 899990): Transaction not final", "status": 476, "title": "Transaction not final", "detail": "Transaction nLockTime is in the future and input sequence numbers are not final; resubmit once the locktime expires", "type": "https://bitcoin-sv.github.io/arc/#/errors?id=_476" }, "expect": { "toolbox_arcade_submit": "service_error", "engine_submit": "transport" } },
    { "name": "submit_400_465_fee", "surface": "submit", "http": 400, "cite": "services/api_server/handlers.go:891-896; validator/errmap.go:55", "body": { "error": "transaction failed validation", "txid": "{TXID}", "reason": "TX_INVALID (31): insufficient-fee", "status": 465, "title": "Fee too low", "detail": "Transaction fee is too low", "type": "https://bitcoin-sv.github.io/arc/#/errors?id=_465" }, "expect": { "toolbox_arcade_submit": "rejected", "engine_submit": "sync_rejected" } },
    { "name": "submit_400_461_script", "surface": "submit", "http": 400, "cite": "validator/errmap.go:66", "body": { "error": "transaction failed validation", "txid": "{TXID}", "reason": "script failed", "status": 461, "title": "Malformed transaction", "detail": "Transaction unlocking scripts are invalid", "type": "https://bitcoin-sv.github.io/arc/#/errors?id=_461" }, "expect": { "toolbox_arcade_submit": "rejected", "engine_submit": "sync_rejected" } },
