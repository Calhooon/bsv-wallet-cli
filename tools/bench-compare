#!/usr/bin/env bash
# Run the hot path's benches (#71) and compare each p99 to this machine's
# entry in benches/baseline.json: a p99 more than the margin (5 percent
# unless the entry names its own) above the baseline fails.
#
#   tools/bench-compare                    compare; no entry for this machine fails
#   tools/bench-compare --record           rewrite this machine's entry (a PR that says so)
#   tools/bench-compare --record-missing   compare, or record when this machine has no entry
#   tools/bench-compare --compare-only DIR compare the JSON already in DIR, run nothing
#
# The machine is BENCH_MACHINE, else on a GitHub runner github-<os>-<arch>,
# else the CPU model and core count. BENCH_OUT keeps the per-bench JSON.
set -euo pipefail

cd "$(dirname "$0")/.."
BENCHES=(gate_assess create_action_signed internalize_action list_outputs)
mode=compare
dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --record) mode=record ;;
    --record-missing) mode=record-missing ;;
    --compare-only) dir="$2"; shift ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "bench-compare: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

cores() { getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu; }
model() {
  if [ "$(uname -s)" = Darwin ]; then
    sysctl -n machdep.cpu.brand_string
  else
    sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1
  fi
}
machine_line="$(model), $(cores) cores"
if [ -n "${BENCH_MACHINE:-}" ]; then
  key="$BENCH_MACHINE"
elif [ "${GITHUB_ACTIONS:-}" = true ]; then
  key="github-${RUNNER_OS:-linux}-${RUNNER_ARCH:-x64}"
else
  key="$machine_line"
fi
key="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//')"

if [ -z "$dir" ]; then
  dir="${BENCH_OUT:-$(mktemp -d "${TMPDIR:-/tmp}/bench-compare.XXXXXX")}"
  mkdir -p "$dir"
  rm -f "$dir"/*.json
  for bench in "${BENCHES[@]}"; do
    BENCH_OUT="$dir" cargo bench --locked --bench "$bench"
  done
fi

python3 - "$mode" "$key" "$machine_line" "$dir" benches/baseline.json <<'PY'
import datetime, glob, json, os, sys

mode, key, machine_line, out, path = sys.argv[1:]
measured = {}
for f in sorted(glob.glob(os.path.join(out, "*.json"))):
    r = json.load(open(f))
    measured[r["id"]] = {"p50_us": r["p50_us"], "p99_us": r["p99_us"], "calls": r["calls"]}
if not measured:
    sys.exit(f"bench-compare: no results in {out}")
baseline = json.load(open(path)) if os.path.exists(path) else {"margin": 0.05, "machines": {}}
entry = baseline["machines"].get(key)

def record():
    baseline["machines"][key] = {
        "machine": machine_line,
        "recorded": datetime.date.today().isoformat(),
        **({"margin": entry["margin"]} if entry and "margin" in entry else {}),
        "benches": measured,
    }
    with open(path, "w") as f:
        json.dump(baseline, f, indent=2, sort_keys=True)
        f.write("\n")
    for id, m in sorted(measured.items()):
        print(f"recorded {id}: p50 {m['p50_us']} us, p99 {m['p99_us']} us ({m['calls']} calls)")
    print(f"bench-compare: recorded {len(measured)} benches for {key} ({machine_line}) in {path}")

if mode == "record" or (mode == "record-missing" and entry is None):
    record()
    sys.exit(0)
if entry is None:
    sys.exit(f"bench-compare: no baseline for {key} ({machine_line}); --record writes one")

margin = entry.get("margin", baseline.get("margin", 0.05))
failed = []
print(f"bench-compare: {key} ({machine_line}), recorded {entry['recorded']}, margin {margin:.0%}")
print(f"{'bench':42} {'p50 us':>10} {'p99 us':>10} {'base p99':>10} {'change':>8}")
for id, base in sorted(entry["benches"].items()):
    m = measured.get(id)
    if m is None:
        failed.append(f"{id}: not measured")
        continue
    change = m["p99_us"] / base["p99_us"] - 1
    verdict = "FAIL" if change > margin else "ok"
    if verdict == "FAIL":
        failed.append(f"{id}: p99 {m['p99_us']} us is {change:+.1%} over {base['p99_us']} us")
    print(f"{id:42} {m['p50_us']:>10} {m['p99_us']:>10} {base['p99_us']:>10} {change:>+8.1%} {verdict}")
for id in sorted(set(measured) - set(entry["benches"])):
    print(f"{id}: not in the baseline (--record adds it)")
if failed:
    print("bench-compare: FAILED", *failed, sep="\n  ")
    sys.exit(1)
print(f"bench-compare: every p99 within {margin:.0%} of the baseline")
PY
