def read(path):
    """A recording's events in seq order, and the numbers of its lines that are not a JSON event."""
    events, bad = [], []
    for n, line in enumerate(Path(path).read_text().splitlines(), 1):
        if not line.strip():
            continue
        try:
            e = json.loads(line)
        except ValueError:
            bad.append(n)
            continue
        if not isinstance(e, dict) or not isinstance(e.get("seq"), int) or "phase" not in e:
            bad.append(n)
            continue
        events.append(e)
    events.sort(key=lambda e: e["seq"])
    return [_hexify(e) for e in events], bad


def load(path):
    return read(path)[0]


